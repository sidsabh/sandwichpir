Purpose: allow CrowdSurf (DistPIR-SPGPU) to build for sm_89 (L40S).
Upstream sm_70 hardcode both in the CMake CUDA arch AND in a runtime major==7
guard. This patch loosens both.

Apply with: patch -p1 -d schemes/distpir < patches/00-distpir-sm89.patch

--- a/matrix/gpu/cuda/CMakeLists.txt
+++ b/matrix/gpu/cuda/CMakeLists.txt
@@ -7,7 +7,7 @@ if("$ENV{CUDACXX}" STREQUAL "")
     project(gpu LANGUAGES CXX)
     add_library(${PROJECT_NAME} SHARED ffi_noop.cpp)
 else()
-    set(CMAKE_CUDA_ARCHITECTURES 70)
+    set(CMAKE_CUDA_ARCHITECTURES 70 89)
     project(gpu LANGUAGES CUDA)
     add_library(${PROJECT_NAME} SHARED ffi.cu gemm.cu)
     target_include_directories(${PROJECT_NAME} PRIVATE
--- a/matrix/gpu/cuda/gemm.cu
+++ b/matrix/gpu/cuda/gemm.cu
@@ -36,8 +36,8 @@ public:
         // Check that our GPU supports the necessary operations
         cudaDeviceProp props;
         CUDA_CHECK(cudaGetDeviceProperties(&props, 0));
-        if (props.major != 7) {
-            std::cerr << "GPU must have compute capability >70" << std::endl;
+        if (props.major < 7) {
+            std::cerr << "GPU must have compute capability >= 7.0 (Volta or newer)" << std::endl;
             exit(1);
         }
     }
