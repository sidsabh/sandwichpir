+// PATCH: deterministic synthetic plaintext coefficient for a flat database index.
+// The benchmark's records are random filler, and every index is read exactly once
+// during encoding, so they can be produced on demand instead of being materialised
+// in a Vec. Being a pure function of the index (rather than sampled) keeps the
+// correctness check below possible: it recomputes just the entries it needs.
+#[inline]
+fn synth_pt(idx: usize, modulus: u64) -> u64 {
+    let mut x = (idx as u64) ^ 0x9E37_79B9_7F4A_7C15;
+    x ^= x >> 30; x = x.wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    x ^= x >> 27; x = x.wrapping_mul(0x94D0_49BB_1331_11EB);
+    x ^= x >> 31;
+    x % modulus
+}
